# Auto-detect text files and normalize line endings to LF on commit/checkout.
# This is the cross-platform safety net: every text file ends up LF on disk.
# CRLF on disk is forbidden in this repo.
* text=auto eol=lf

# Be explicit for source/config/docs to make audit easy.
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

# Binary files — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.whl   binary
*.egg   binary
